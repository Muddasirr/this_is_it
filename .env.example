DATABASE_URL=postgresql+psycopg://futsal:futsal@localhost:5433/futsal
REDIS_URL=redis://localhost:6379/0
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/videos
API_PUBLIC_URL=http://localhost:8000
JWT_SECRET=dev-change-me
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=http://localhost:8000
# Kaggle access token (put real value in .env — never commit secrets)
KAGGLE_API_TOKEN=
# Vision: OCR on (throttled). Set 0 only for emergency speed runs.
VISION_JERSEY_OCR=1
VISION_OCR_TIMEOUT_S=0.8
# Tracker: botsort (default, GMC) | bytetrack (legacy)
VISION_TRACKER=botsort
# OSNet ReID fragment merge (1=on)
VISION_REID=1
VISION_REID_MODEL=osnet_x0_25
VISION_REID_EVERY=3
# Optional S3 / MinIO (set STORAGE_BACKEND=s3)
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=futsal-videos

# Futsal court size: 5v5 | 6v6 | 7v7
COURT_FORMAT=5v5
# Detector: COCO yolov8n.pt (default; facility CCTV). Futsal fine-tune
# (yolov8n_futsal.pt) helps on Roboflow/broadcast domain; auto-falls back to
# COCO if that model finds no players. Ball retry always uses COCO sports_ball
# when primary is a custom futsal model.
# YOLO_MODEL=yolov8n_futsal.pt
ROBOFLOW_API_KEY=
